+export async function compactResponse(
+  accessToken: string,
+  options: CompactResponseOptions,
+  signal: AbortSignal,
+): Promise<{ compactedContext: string }> {
+  if (!Array.isArray(options.input) || !options.input.length || options.input.some((item) => !validInputItem(item))) {
+    throw new ChatGPTError("invalid_request", "Use valid transcript or compacted input items.");
+  }
+  const requestSignal = AbortSignal.any([signal, AbortSignal.timeout(180_000)]);
+  try {
+    const result = await createClient(accessToken).responses.compact({
+      model: options.model,
+      input: options.input.map(apiInputItem),
+    } as OpenAI.Responses.ResponseCompactParams, { signal: requestSignal });
+    const output = result.output;
+    if (!Array.isArray(output) || !output.length || output.some((item) => !validInputItem(item)) ||
+        output.at(-1)?.type !== "compaction") {
+      throw new ChatGPTError("invalid_compaction", "ChatGPT returned invalid compacted context.");
+    }
+    return { compactedContext: JSON.stringify(output) };
+  } catch (error) {
+    if (signal.aborted) throw new ChatGPTError("cancelled", "The response was cancelled.");
+    if (error instanceof ChatGPTError) throw error;
+    if (error instanceof OpenAI.APIError && !(error instanceof OpenAI.APIConnectionError) && !(error instanceof OpenAI.APIUserAbortError)) {
+      const detail = typeof error.error === "string" ? { error: error.error } : error.error;
+      throw apiError(detail, error.status, error.requestID);
+    }
+    throw new ChatGPTError("network_error", "Could not compact the conversation. Try again later.", true);
+  }
+}
