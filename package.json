{
  "name": "browsefriend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:devkit": "node scripts/setup-devkit.mjs",
    "install:host": "node native-host/install.mjs",
    "uninstall:host": "node native-host/install.mjs --uninstall",
    "test": "node --test tests/*.test.mjs tests/extension/*.test.mjs tests/native-host/*.test.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "verify": "npm run lint && npm test && node -e \"JSON.parse(require('node:fs').readFileSync('manifest.json', 'utf8'))\""
  }
}
