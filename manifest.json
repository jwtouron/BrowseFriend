{
  "manifest_version": 3,
  "name": "BrowseFriend",
  "version": "0.2.0",
  "description": "A local-first web companion that lives in Chrome's side panel.",
  "key": "",
  "minimum_chrome_version": "141",
  "action": {
    "default_title": "Toggle BrowseFriend"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["nativeMessaging", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
