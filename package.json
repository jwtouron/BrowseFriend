{
  "name": "browsefriend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:host": "go run ./native-host/cmd/build --check",
    "test:host": "go run ./native-host/cmd/build --check --test",
    "install:host": "go run ./native-host/cmd/build --check && ./build/browsefriend-native-host install",
    "uninstall:host": "./build/browsefriend-native-host uninstall",
    "pretest": "go run ./native-host/cmd/build --check --test",
    "test": "node --test tests/*.test.mjs tests/extension/*.test.mjs tests/native-host/*.test.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "verify": "npm run lint && npm test && node -e \"JSON.parse(require('node:fs').readFileSync('manifest.json', 'utf8'))\""
  }
}
