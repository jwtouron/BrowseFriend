{
  "manifest_version": 3,
  "name": "ChatGPT Sidecar",
  "version": "0.1.0",
  "description": "A starter chat interface that lives in Chrome's side panel.",
  "minimum_chrome_version": "141",
  "action": {
    "default_title": "Toggle Sidecar"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
